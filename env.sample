PORT=3344
HOST=127.0.0.1
DATA_DIR=data
LOCAL_ONLY=true
COORDINATOR_PROVIDER=synthetic_fixture
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
LOCAL_MODEL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL_NAME=nvidia-nemotron-3-nano-4b
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
DEMO_FALLBACK_ENABLED=true
TOKEN_SIGNING_SECRET=

# Optional hardening. Every line below is commented out; the code default applies until you remove the leading #.
# Failed sign-in throttle: this many refused 43-character tokens that match no registered identity, inside the window, lock that client for the lock time (429 + Retry-After). Prefixes of a token being typed never count.
# AUTH_MAX_FAILURES=10
# AUTH_WINDOW_SECONDS=60
# AUTH_LOCK_SECONDS=60
# Take the client address from the first X-Forwarded-For entry. Set true only behind a proxy that overwrites that header.
# TRUST_PROXY=false
# Comma separated IPv4/IPv6 CIDRs. Unset or empty means no restriction; set means every other client gets 403 and a value listing no network stops startup. Loopback is not implicit.
# ALLOWED_CLIENT_CIDRS=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32
# Off by default. true: a WAIT at the last part of the window with the pickup incomplete is escalated to a person (DEADLINE_NEAR).
# FOLLOWUP_FLOOR=false
# Serve https directly. Both files are needed; a local certificate for a LAN address comes from scripts/local-tls-cert.mjs.
# TLS_CERT_FILE=data/tls/cert.pem
# TLS_KEY_FILE=data/tls/key.pem
# Token Factory spending ceiling in USD. A budget without both prices counts as exhausted; do not leave NEBIUS_BUDGET_USD set but empty.
# NEBIUS_BUDGET_USD=20
# NEBIUS_PRICE_INPUT_PER_M=0.30
# NEBIUS_PRICE_OUTPUT_PER_M=0.90
# Keep the two legacy compatibility paths (/api/policy/recommend, coordinator `recommend`) from calling the hosted model; they send more than the five fields of the file workflow. Exactly "off" turns this on.
# LEGACY_HOSTED_ADVICE=off
# Follow-up prompt profile. Exactly "directive" selects the directive JUDGEMENT text (opt-in; the default prompt is unchanged). See docs/agent/followup-prompt-profile-2026-10-08.md.
# FOLLOWUP_PROMPT=directive

# Optional OIDC single sign-on (authorization code + PKCE). Off unless SSO_ISSUER is set; see docs/agent/sso.md. Any mistake once SSO_ISSUER is set makes every /api/sso/* route answer 503. Do not combine with the judge demo gate: the identity provider's redirect would arrive without the gate cookie.
# SSO_ISSUER=https://idp.example.org
# SSO_CLIENT_ID=
# Leave empty for a public client (PKCE only). Never commit a value.
# SSO_CLIENT_SECRET=
# Must be exactly https://<this host>/api/sso/callback
# SSO_REDIRECT_URI=https://enclave.example.org/api/sso/callback
# SSO_SCOPES=openid email
# Local JSON file mapping an IdP sub or verified e-mail to an existing registry principal id. Keep it outside the repository.
# SSO_SUBJECT_MAP=data/sso-subjects.json
# 1 to 480
# SSO_SESSION_MINUTES=30
# Tests only: allow http for 127.0.0.1, localhost and [::1].
# SSO_ALLOW_LOOPBACK_IDP=false

# Off unless WEBHOOK_URL is set. Tells your own receiver that a prepared notice exists (signed, link only, no recipients). The application still sends no email. See docs/agent/webhook-notices.md.
# WEBHOOK_URL=https://hooks.example.com/enclave-notice
# Required with WEBHOOK_URL: comma separated host names, exact match, no wildcards. The URL port must be 443.
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# Required with WEBHOOK_URL: at least 16 characters, not one repeated character, no surrounding whitespace. The receiver verifies X-Enclave-Signature with it. Never commit a real value.
# WEBHOOK_SECRET=
# Required with WEBHOOK_URL: the public https address of this application, used to build the link.
# PUBLIC_BASE_URL=https://enclave.example.com
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_MAX_ATTEMPTS=5
# Tests and a same-host receiver only: allows http://127.0.0.1 and http://[::1].
# WEBHOOK_ALLOW_LOOPBACK=false

# Off by default. local_then_nebius: ask the local model first and the hosted model only if the local call failed or its answer is unusable (same five fields, at most one hosted call per decision, 10 s in all). The server refuses to start unless LOCAL_ONLY=false, LEGACY_HOSTED_ADVICE=off and NEBIUS_BUDGET_USD with both prices are set; it also needs NEBIUS_API_KEY for the hosted call to be possible. See docs/agent/cascade-outlet.md.
# COORDINATOR_PROVIDER=local_then_nebius

# Off by default. local: ask the loopback model for a second opinion on a recipient match (codes only, it can only add care). dual: also ask the hosted model. Exact values only. See docs/agent/recipient-matching.md.
# MATCH_AI_REVIEW=local

# Off by default. vector: order the sender's recipient list by similarity to a short text, using an embedding model on this machine (loopback only; LOCAL_MODEL_BASE_URL). Display order only; it never selects anyone. Exact value only. See docs/agent/recipient-matching.md.
# RECIPIENT_RANKING=vector
# EMBEDDING_MODEL_NAME=text-embedding-nomic-embed-text-v1.5

# Off by default. local: ask the loopback model for a second opinion on a delivery status check (codes only; it can raise the level by one step, never lower it). dual: also ask the hosted model. Exact values only. See docs/agent/recipient-matching.md.
# STATE_AI_REVIEW=local

# Off by default. local: a model on this machine reads the sender's note into the search fields. The note goes to that model and is not stored; the model never sees the directory. Exact value only. See docs/agent/recipient-matching.md.
# NOTE_AI=local

# Behind a Cloudflare Worker edge (deploy/cloudflare-edge/): at least 32 characters, never committed. REQUIRE_EDGE=true refuses
# requests that did not come through the edge (the health check stays open); it needs EDGE_SECRET.
# EDGE_SECRET=
# REQUIRE_EDGE=false
# EDGE_REDIRECT_TO=https://site.example   (an https origin, no path; needs REQUIRE_EDGE; sends bypassing GET/HEAD requests there with a 307)

# How many staged file deliveries this instance keeps (default 50, at most 1000). Nothing purges them, so it is the most deliveries the instance can ever take.
# FILE_TASK_LIMIT=50
